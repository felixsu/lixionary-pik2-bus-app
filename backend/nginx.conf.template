# ==============================================================================
# Nginx Configuration Template for Pik2Bus Backend
# ==============================================================================
# Place this configuration on your VPS at /etc/nginx/sites-available/pik2bus
# and symlink it to /etc/nginx/sites-enabled/
#
# Remember to install Certbot for Let's Encrypt SSL/TLS certificates:
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d yourdomain.com
# ==============================================================================

# 1. Define Request Rate Limiting Zone
# Limit each IP address to 10 requests per second.
# We allocate 10MB to store state (handles ~160,000 IPs).
limit_req_zone $binary_remote_addr zone=pik2bus_api_limit:10m rate=10r/s;

server {
    listen 80;
    server_name yourdomain.com; # <--- REPLACE with your domain name or VPS public IP

    # Redirect all HTTP requests to HTTPS (Certbot will automate this block if run)
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name yourdomain.com; # <--- REPLACE with your domain name or VPS public IP

    # SSL certificates (These paths will be populated/managed automatically by Certbot)
    # ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Log files
    access_log /var/log/nginx/pik2bus_access.log;
    error_log /var/log/nginx/pik2bus_error.log;

    # 2. Allow Healthcheck endpoint without rate limiting
    location /health {
        proxy_pass http://127.0.0.1:8020/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Main Proxy Location with Rate Limiting and SSE Support
    location / {
        # Enforce rate limit zone with a burst capacity of 20 requests
        limit_req zone=pik2bus_api_limit burst=20 nodelay;

        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events (SSE) specific proxy settings:
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        
        # CRITICAL: Disable buffering & caching so SSE streams render immediately!
        proxy_buffering off;
        proxy_cache off;
        
        # Set large read timeout to prevent Nginx from severing idle SSE connections
        proxy_read_timeout 24h;
    }
}
